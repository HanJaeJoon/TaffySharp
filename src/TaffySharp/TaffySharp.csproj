<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Only the main entry points carry XML docs; the rest mirrors upstream taffy (see docs.rs/taffy) -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Authors>HanJaeJoon</Authors>
    <Description>A pure C# port of taffy, the Rust flexbox, CSS grid and block layout engine.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/HanJaeJoon/TaffySharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HanJaeJoon/TaffySharp.git</RepositoryUrl>
    <PackageTags>layout, flexbox, css-grid, grid, block, taffy, ui, CSharp, .NET</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) HanJaeJoon</Copyright>
    <PackageReleaseNotes>See https://github.com/HanJaeJoon/TaffySharp/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

    <!-- SourceLink: lets package consumers step into the GitHub sources while debugging -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generates the types newer C# features (init, required, etc.) need on netstandard at compile time (no runtime dependency) -->
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" Condition="$(TargetFramework.StartsWith('netstandard'))" />
    <!-- netstandard2.0 has no Span<T>/ReadOnlySpan<T> (inbox from 2.1) -->
    <PackageReference Include="System.Memory" Version="4.6.3" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests exercise internal algorithm helpers directly -->
    <InternalsVisibleTo Include="TaffySharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
